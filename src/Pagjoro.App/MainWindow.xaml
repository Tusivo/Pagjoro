<Window x:Class="Pagjoro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagjoro" Width="1100" Height="760" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="Assets/Pagjoro.png" Width="56" Height="56" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="32" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Opacity="0.75" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Padding="16,12" CornerRadius="8" BorderThickness="1"
                BorderBrush="{StaticResource AccentBrush}">
            <TextBlock TextWrapping="Wrap" x:Name="StatusText" />
        </Border>

        <!-- Updates: looks only when the button is pressed; installs only a release that carries Pagjoro's signature -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,8" Opacity="0.75" TextWrapping="Wrap"
                       Text="Pagjoro looks for a newer version only when you press the button. It contacts GitHub, sends nothing about you or your files, and installs a new version only if it carries Pagjoro's release signature. Your current copy is kept as a backup in the same folder." />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CheckButton" Content="Check for Updates" Padding="14,6" Click="OnCheck" />
                <Button x:Name="InstallButton" Content="Download and Install" Padding="14,6" Margin="12,0,0,0" Visibility="Collapsed" Click="OnInstall" />
            </StackPanel>
            <TextBlock x:Name="UpdateText" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,24,0,8" Text="About Pagjoro" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Top" />
        <TextBox Grid.Row="3" Margin="0,52,0,0" x:Name="AboutBox" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock>
                <Hyperlink NavigateUri="https://github.com/Tusivo/Pagjoro" RequestNavigate="OnLink">Source code on GitHub</Hyperlink>
            </TextBlock>
            <TextBlock Margin="24,0,0,0">
                <Hyperlink NavigateUri="mailto:info@tusivo.com" RequestNavigate="OnLink">info@tusivo.com</Hyperlink>
            </TextBlock>
            <TextBlock Margin="24,0,0,0" x:Name="LicenseText" Opacity="0.75" />
        </StackPanel>
    </Grid>
</Window>
