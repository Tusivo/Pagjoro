<Window x:Class="Pagjoro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pagjoro.App"
        Title="Pagjoro" Width="1360" Height="860" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
    <Window.Resources>
        <!-- toolbar buttons: no box at rest, just the icon; a soft tint on hover and while a tool is on -->
        <!-- a slim menu bar: each top-level title is a small, flat header with its own drop-down -->
        <SolidColorBrush x:Key="MenuPopupBrush" Color="#2B2B2B" />
        <ControlTemplate x:Key="SlimHeader" TargetType="MenuItem">
            <Grid>
                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="9,2">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{DynamicResource MenuPopupBrush}" BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,2,8,8" MinWidth="190">
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" /></Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#26808080" /></Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bd" Property="Background" Value="#33808080" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="SlimMenuItem" TargetType="MenuItem">
            <Setter Property="Template" Value="{StaticResource SlimHeader}" />
        </Style>
        <Style x:Key="Tb" TargetType="Button">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26808080" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#40808080" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TbToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26808080" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33808080" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Open}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Save}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{x:Static ApplicationCommands.SaveAs}" />
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Print}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Find}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Undo}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Redo}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Copy}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="OnOpen" />
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="OnSave" CanExecute="HasDocument" />
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" Executed="OnSaveAs" CanExecute="HasDocument" />
        <CommandBinding Command="{x:Static ApplicationCommands.Print}" Executed="OnPrint" CanExecute="HasDocument" />
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFocusSearch" CanExecute="HasDocument" />
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}" Executed="OnUndo" CanExecute="HasDocument" />
        <CommandBinding Command="{x:Static ApplicationCommands.Redo}" Executed="OnRedo" CanExecute="HasDocument" />
        <CommandBinding Command="{x:Static ApplicationCommands.Copy}" Executed="OnCopy" CanExecute="HasDocument" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- menus and the always-visible toolbar -->
        <StackPanel Grid.Row="0">
            <DockPanel x:Name="MenuRow" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,10,2">
                    <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                    <ComboBox x:Name="ThemeBox" Width="92" Height="22" MinHeight="0" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Colours of the window" SelectionChanged="OnThemePicked">
                        <ComboBoxItem Content="Dark" Tag="dark" />
                        <ComboBoxItem Content="Light" Tag="light" />
                        <ComboBoxItem Content="Night" Tag="night" />
                    </ComboBox>
                </StackPanel>
            <Menu x:Name="MainMenu" Background="Transparent" ItemContainerStyle="{StaticResource SlimMenuItem}" VerticalAlignment="Center">
                <MenuItem Header="_File">
                    <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OnOpen" />
                    <MenuItem x:Name="RecentMenu" Header="Open _Recent" />
                    <Separator />
                    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="OnSave" />
                    <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="OnSaveAs" />
                    <Separator />
                    <MenuItem Header="_Print..." InputGestureText="Ctrl+P" Click="OnPrint" />
                    <MenuItem Header="Document _Properties..." Click="OnProperties" />
                    <MenuItem Header="_Batch Process Files..." Click="OnBatch" />
                    <Separator />
                    <MenuItem Header="_Close File" Click="OnCloseFile" />
                    <MenuItem Header="E_xit" Click="OnExit" />
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndo" />
                    <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedo" />
                    <Separator />
                    <MenuItem Header="_Copy Selected Text" InputGestureText="Ctrl+C" Click="OnCopy" />
                    <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="OnFocusSearch" />
                    <Separator />
                    <MenuItem Header="_Edit Text or Pictures" Click="OnToolMenu" Tag="EditContent" />
                    <MenuItem Header="Add _Text" Click="OnToolMenu" Tag="Text" />
                    <MenuItem Header="Add _Picture" Click="OnToolMenu" Tag="Image" />
                    <MenuItem x:Name="StampMenu" Header="_Stamp" />
                    <MenuItem Header="Add a _Link" Click="OnToolMenu" Tag="LinkArea" />
                    <MenuItem Header="_Watermark..." Click="OnWatermark" />
                    <MenuItem Header="_Header and Footer..." Click="OnHeaderFooter" />
                    <MenuItem Header="_Page Numbers..." Click="OnPageNumbers" />
                    <MenuItem Header="_Bates Numbers..." Click="OnBates" />
                    <MenuItem Header="F_latten Marks" Click="OnFlatten" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Zoom _In" Click="OnZoomIn" />
                    <MenuItem Header="Zoom _Out" Click="OnZoomOut" />
                    <MenuItem Header="Fit _Width" Click="OnFitWidth" />
                    <MenuItem Header="Fit _Page" Click="OnFitPage" />
                    <MenuItem Header="_Actual Size" Click="OnActualSize" />
                    <MenuItem x:Name="FacingItem" Header="_Two Pages Side by Side" IsCheckable="True" Click="OnToggleFacing" />
                    <Separator />
                    <MenuItem Header="_Previous Page" Click="OnPrevPage" />
                    <MenuItem Header="_Next Page" Click="OnNextPage" />
                    <MenuItem Header="_Go to Page..." Click="OnGoToPage" />
                </MenuItem>
                <MenuItem Header="_Comment">
                    <MenuItem Header="_Select Text" Click="OnToolMenu" Tag="Select" />
                    <MenuItem Header="_Highlight" Click="OnToolMenu" Tag="Highlight" />
                    <MenuItem Header="_Underline" Click="OnToolMenu" Tag="Underline" />
                    <MenuItem Header="S_trike Through" Click="OnToolMenu" Tag="Strikeout" />
                    <MenuItem Header="_Note" Click="OnToolMenu" Tag="Note" />
                    <MenuItem Header="_Draw" Click="OnToolMenu" Tag="Draw" />
                    <MenuItem Header="_Rectangle" Click="OnToolMenu" Tag="Rectangle" />
                    <MenuItem Header="_Oval" Click="OnToolMenu" Tag="Ellipse" />
                    <Separator />
                    <MenuItem Header="_Marks List" Click="OnShowMarks" />
                </MenuItem>
                <MenuItem Header="_Pages">
                    <MenuItem Header="Rotate _Left" Click="OnRotateLeft" />
                    <MenuItem Header="Rotate _Right" Click="OnRotateRight" />
                    <MenuItem Header="_Delete Pages" Click="OnDeletePages" />
                    <Separator />
                    <MenuItem Header="Move _Up" Click="OnMoveUp" />
                    <MenuItem Header="Move _Down" Click="OnMoveDown" />
                    <Separator />
                    <MenuItem Header="_Extract Pages..." Click="OnExtractPages" />
                    <MenuItem Header="Insert _Blank Page" Click="OnInsertBlank" />
                    <MenuItem Header="Insert _From File..." Click="OnInsertFromFile" />
                    <MenuItem Header="_Merge Files..." Click="OnMerge" />
                    <MenuItem Header="_Split Document..." Click="OnSplit" />
                    <MenuItem Header="_Crop Pages..." Click="OnCrop" />
                </MenuItem>
                <MenuItem Header="For_ms">
                    <MenuItem Header="_Fill In Form..." Click="OnFillForm" />
                    <Separator />
                    <MenuItem Header="Add _Text Field" Click="OnToolMenu" Tag="TextField" />
                    <MenuItem Header="Add _Check Box" Click="OnToolMenu" Tag="CheckField" />
                    <Separator />
                    <MenuItem Header="_Export Form Data..." Click="OnExportFormData" />
                    <MenuItem Header="_Import Form Data..." Click="OnImportFormData" />
                </MenuItem>
                <MenuItem Header="Pr_otect">
                    <MenuItem Header="Set _Password..." Click="OnSetPassword" />
                    <MenuItem Header="_Remove Password" Click="OnRemovePassword" />
                    <Separator />
                    <MenuItem Header="_Mark for Redaction" Click="OnToolMenu" Tag="Redact" />
                    <MenuItem Header="_Find and Redact..." Click="OnRedactPatterns" />
                    <MenuItem Header="_Apply Redactions" Click="OnApplyRedactions" />
                    <MenuItem Header="_Clear Redaction Boxes" Click="OnClearRedactions" />
                    <Separator />
                    <MenuItem Header="Remove _Hidden Data" Click="OnSanitize" />
                    <Separator />
                    <MenuItem Header="_Sign Document..." Click="OnSign" />
                    <MenuItem Header="C_heck Signatures" Click="OnCheckSignatures" />
                </MenuItem>
                <MenuItem Header="_Review">
                    <MenuItem Header="_Recognize Text (OCR)..." Click="OnRecognizeText" />
                    <MenuItem Header="_Accessibility Check..." Click="OnAccessibilityCheck" />
                    <MenuItem Header="_Print and Sharing Check..." Click="OnPrintCheck" />
                    <MenuItem Header="Reading _Options..." Click="OnReadingOptions" />
                    <Separator />
                    <MenuItem Header="_Bookmarks..." Click="OnBookmarks" />
                    <MenuItem Header="Page _Numbering..." Click="OnPageLabels" />
                    <MenuItem Header="Attach_ments..." Click="OnAttachments" />
                    <Separator />
                    <MenuItem Header="_Compare With Another File..." Click="OnCompare" />
                    <MenuItem Header="Document _Information..." Click="OnEditInfo" />
                    <MenuItem Header="_Reduce File Size" Click="OnCompress" />
                </MenuItem>
                <MenuItem Header="C_onvert">
                    <MenuItem Header="Export Pages as _Images..." Click="OnExportImages" />
                    <MenuItem Header="Export _Text..." Click="OnExportText" />
                    <MenuItem Header="_Pictures to PDF..." Click="OnImagesToPdf" />
                    <MenuItem Header="_Office File to PDF..." Click="OnOfficeToPdf" />
                    <MenuItem Header="_Scan to PDF..." Click="OnScan" />
                    <Separator />
                    <MenuItem Header="Export as _Web Page..." Click="OnExportHtml" />
                    <MenuItem Header="Export as _Word Document..." Click="OnExportWord" />
                    <MenuItem Header="Export as _Excel Workbook..." Click="OnExportExcel" />
                    <MenuItem Header="Export as _CSV..." Click="OnExportCsv" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="Make Pagjoro the _Default PDF App..." Click="OnDefaultApp" />
                    <MenuItem Header="_Check for Updates..." Click="OnCheckUpdates" />
                    <MenuItem Header="_About Pagjoro" Click="OnAbout" />
                    <Separator />
                    <MenuItem Header="Report a _Problem" Click="OnReportProblem" />
                    <MenuItem Header="Request a _Feature" Click="OnRequestFeature" />
                    <MenuItem Header="_Support the Project" Click="OnSupport" />
                </MenuItem>
            </Menu>
            </DockPanel>

            <ToolBarTray x:Name="Tray" IsLocked="True">
                <ToolBar Band="0" BandIndex="0">
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Open}" Click="OnOpen" ToolTip="Open a PDF (Ctrl+O)" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Save}" Click="OnSave" ToolTip="Save (Ctrl+S)" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Print}" Click="OnPrint" ToolTip="Print (Ctrl+P)" />
                    <Separator />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Undo}" Click="OnUndo" ToolTip="Undo (Ctrl+Z)" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Redo}" Click="OnRedo" ToolTip="Redo (Ctrl+Y)" />
                    <Separator />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon ZoomOut}" Click="OnZoomOut" ToolTip="Zoom out" />
                    <ComboBox x:Name="ZoomBox" Width="86" IsEditable="True" Margin="2,0" ToolTip="Zoom" SelectionChanged="OnZoomPicked" KeyDown="OnZoomKey" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon ZoomIn}" Click="OnZoomIn" ToolTip="Zoom in" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon FitWidth}" Click="OnFitWidth" ToolTip="Fit the page to the window width" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon FitPage}" Click="OnFitPage" ToolTip="Fit the whole page in the window" />
                    <Separator />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Prev}" Click="OnPrevPage" ToolTip="Previous page" />
                    <TextBox x:Name="PageBox" Width="46" TextAlignment="Center" Margin="2,0" ToolTip="Page number (press Enter to go)" KeyDown="OnPageBoxKey" />
                    <TextBlock x:Name="PageOf" Text="/ 0" VerticalAlignment="Center" Margin="2,0,6,0" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Next}" Click="OnNextPage" ToolTip="Next page" />
                    <Separator />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Find}" Click="OnFocusSearch" ToolTip="Search the document (Ctrl+F)" />
                </ToolBar>
                <ToolBar Band="1" BandIndex="0">
                    <ToggleButton x:Name="ToolSelect" Style="{StaticResource TbToggle}" Content="{local:Icon Select}" Click="OnTool" Tag="Select" IsChecked="True" ToolTip="Select and copy text" />
                    <Separator />
                    <ToggleButton x:Name="ToolHighlight" Style="{StaticResource TbToggle}" Content="{local:Icon Highlight}" Click="OnTool" Tag="Highlight" ToolTip="Highlight: drag over text" />
                    <ToggleButton x:Name="ToolUnderline" Style="{StaticResource TbToggle}" Content="{local:Icon Underline}" Click="OnTool" Tag="Underline" ToolTip="Underline: drag over text" />
                    <ToggleButton x:Name="ToolStrike" Style="{StaticResource TbToggle}" Content="{local:Icon Strike}" Click="OnTool" Tag="Strikeout" ToolTip="Strike through: drag over text" />
                    <ToggleButton x:Name="ToolNote" Style="{StaticResource TbToggle}" Content="{local:Icon Note}" Click="OnTool" Tag="Note" ToolTip="Note: click where the note should go" />
                    <ToggleButton x:Name="ToolDraw" Style="{StaticResource TbToggle}" Content="{local:Icon Draw}" Click="OnTool" Tag="Draw" ToolTip="Draw freehand" />
                    <ToggleButton x:Name="ToolRect" Style="{StaticResource TbToggle}" Content="{local:Icon Box}" Click="OnTool" Tag="Rectangle" ToolTip="Draw a rectangle" />
                    <ToggleButton x:Name="ToolOval" Style="{StaticResource TbToggle}" Content="{local:Icon Oval}" Click="OnTool" Tag="Ellipse" ToolTip="Draw an oval" />
                    <TextBlock Text="Colour" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <ComboBox x:Name="ColorBox" Width="88" SelectionChanged="OnColor" SelectedIndex="0" ToolTip="Colour for marks">
                        <ComboBoxItem Content="Yellow" Tag="Yellow" />
                        <ComboBoxItem Content="Green" Tag="Green" />
                        <ComboBoxItem Content="Blue" Tag="Blue" />
                        <ComboBoxItem Content="Red" Tag="Red" />
                    </ComboBox>
                    <Separator />
                    <ToggleButton x:Name="ToolEdit" Style="{StaticResource TbToggle}" Content="{local:Icon EditContent}" Click="OnTool" Tag="EditContent" ToolTip="Edit text or pictures: click one to change it, drag to move it" />
                    <ToggleButton x:Name="ToolText" Style="{StaticResource TbToggle}" Content="{local:Icon Text}" Click="OnTool" Tag="Text" ToolTip="Add text: click on the page where it should go" />
                    <ToggleButton x:Name="ToolImage" Style="{StaticResource TbToggle}" Content="{local:Icon Picture}" Click="OnTool" Tag="Image" ToolTip="Add a picture: drag a box, then choose the picture" />
                    <Separator />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Form}" Click="OnFillForm" ToolTip="Fill in the form fields of this document" />
                    <ToggleButton x:Name="ToolField" Style="{StaticResource TbToggle}" Content="{local:Icon TextField}" Click="OnTool" Tag="TextField" ToolTip="Add a text field: drag a box" />
                    <ToggleButton x:Name="ToolCheck" Style="{StaticResource TbToggle}" Content="{local:Icon CheckBox}" Click="OnTool" Tag="CheckField" ToolTip="Add a check box: drag a small box" />
                    <Separator />
                    <ToggleButton x:Name="ToolRedact" Style="{StaticResource TbToggle}" Content="{local:Icon Redact}" Click="OnTool" Tag="Redact" ToolTip="Redact: drag a box over what must be removed" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Apply}" Click="OnApplyRedactions" ToolTip="Apply redactions: permanently remove everything under the red boxes" />
                    <Separator />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Rotate}" Click="OnRotateRight" ToolTip="Rotate the selected pages clockwise" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Delete}" Click="OnDeletePages" ToolTip="Delete the selected pages" />
                    <Button Style="{StaticResource Tb}" Content="{local:Icon Sign}" Click="OnSign" ToolTip="Sign with a certificate on this computer" />
                </ToolBar>
            </ToolBarTray>
        </StackPanel>

        <!-- document area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="SideTabs" Grid.Column="0">
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><ContentControl Content="{local:Icon Pages}" Margin="0,0,6,0" /><TextBlock Text="Pages" /></StackPanel></TabItem.Header>
                    <ListBox x:Name="Thumbs" SelectionMode="Extended" SelectionChanged="OnThumbSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True" PreviewMouseMove="OnThumbDragStart" Drop="OnThumbDrop" HorizontalContentAlignment="Center">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <Border BorderBrush="Gray" BorderThickness="1" Background="White">
                                        <Image Source="{Binding Image}" Width="150" Height="{Binding ThumbHeight}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><ContentControl Content="{local:Icon Outline}" Margin="0,0,6,0" /><TextBlock Text="Outline" /></StackPanel></TabItem.Header>
                    <ListBox x:Name="Outline" SelectionChanged="OnOutlineSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><ContentControl Content="{local:Icon Marks}" Margin="0,0,6,0" /><TextBlock Text="Marks" /></StackPanel></TabItem.Header>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="6">
                            <Button Content="Edit Words..." Click="OnEditMark" Margin="0,0,0,4" ToolTip="Change the text of the chosen mark" />
                            <Button Content="Use Toolbar Colour" Click="OnRecolorMark" Margin="0,0,0,4" ToolTip="Give the chosen mark the colour picked in the toolbar" />
                            <Button Content="Remove Selected Mark" Click="OnRemoveMark" />
                        </StackPanel>
                        <ListBox x:Name="MarksList" SelectionChanged="OnMarkSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.75" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter x:Name="SideSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- search -->
                <Border x:Name="SearchBar" Grid.Row="0" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="Gray" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SearchBox" Width="260" KeyDown="OnSearchKey" />
                        <Button Content="Find" Margin="6,0,0,0" Padding="10,4" Click="OnSearch" />
                        <Button Content="Previous" Margin="6,0,0,0" Padding="10,4" Click="OnSearchPrev" />
                        <Button Content="Next" Margin="6,0,0,0" Padding="10,4" Click="OnSearchNext" />
                        <CheckBox x:Name="CaseBox" Content="Match case" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="WordBox" Content="Whole words" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SearchCount" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <Button Content="Close" Margin="12,0,0,0" Padding="10,4" Click="OnCloseSearch" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF7A7F85">
                    <local:DocumentView x:Name="View" />
                </ScrollViewer>

            </Grid>

            <!-- shown until a file is open -->
            <Border x:Name="Welcome" Grid.Column="0" Grid.ColumnSpan="3">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <Image Source="Assets/Pagjoro.png" Width="112" Height="112" HorizontalAlignment="Center" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Pagjoro" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Free PDF tools that run on your own computer." Opacity="0.75" HorizontalAlignment="Center" Margin="0,4,0,24" />
                    <Button Content="Open a PDF..." Padding="28,12" FontSize="16" HorizontalAlignment="Center" Click="OnOpen" />
                    <TextBlock Text="Or drag a PDF file onto this window." Opacity="0.65" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock x:Name="RecentTitle" Text="Recent files" FontWeight="SemiBold" Margin="0,28,0,6" Visibility="Collapsed" />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2">
                                    <Hyperlink NavigateUri="{Binding Path}" RequestNavigate="OnRecent"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                                    <Run Text="{Binding Folder, Mode=OneWay}" Foreground="Gray" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- status -->
        <StatusBar x:Name="Status" Grid.Row="2">
            <StatusBarItem><TextBlock x:Name="PageStatus" Text="" /></StatusBarItem>
            <StatusBarItem><TextBlock x:Name="ZoomStatus" Text="" /></StatusBarItem>
            <StatusBarItem><TextBlock x:Name="MessageStatus" Text="" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="VersionStatus" Opacity="0.7" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
